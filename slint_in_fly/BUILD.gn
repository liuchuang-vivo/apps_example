import("//build/boards/${board}.gni")
import("//build/templates/reload_autoconf_and_build.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

_slint_ui_generated = "${target_gen_dir}/slint_ui_main_window.rs"

action("generate_slint_ui") {
  script = "//build/scripts/run_slint_cli.py"
  inputs = [ "app.slint" ]
  outputs = [ _slint_ui_generated ]
  args = [
    "--embed-resources",
    "software-renderer",
    "--output",
    rebase_path(_slint_ui_generated),
    rebase_path(inputs[0]),
  ]
}

reload_autoconf_and_build("slint_in_fly") {
  app_conf = [ "app.conf" ]
  crate_name = "slint_ui_example"
  crate_type = "bin"

  sources = [ "src/main.rs" ]
  inputs = [ _slint_ui_generated ]
  rustenv = [ "SLINT_UI_GENERATED=" + rebase_path(_slint_ui_generated) ]
  deps = [
    ":generate_slint_ui",
    "//external/vendor/libm-0.2.16:libm",
    "//external/vendor/slint-1.17.1:slint",
    "//external/vendor/linked_list_allocator-0.10.6:linked_list_allocator",
    "//external/vendor/spin-0.9.8:spin",
    "//libc",
    "//librs:librs_swi",
    "//external/vendor/portable-atomic-1.13.1:portable_atomic",
    "//kernel/kernel:atomic",
  ]
  rustflags = [
    "-Cpanic=abort",
    "-Crelocation-model=static",
    "-Clink-arg=-Wl,-static",
    "-Clink-arg=-Wl,--no-pie",
    "-Clink-arg=-Wl,--strip-all",
    "-Clink-arg=-nostartfiles",
  ]
  # The ESP32-C3 and C6 XIP layouts use different SRAM mappings.
  if (board == "seeed_xiao_esp32c3") {
    linker_script = rebase_path("//apps/example/slint_in_fly/xip_link.x")
  } else if (board == "esp32c6_devkitc_1") {
    linker_script =
        rebase_path("//apps/example/slint_in_fly/xip_link.esp32c6.x")
  } else if (defined(default_linker_script)) {
    # Keep the target usable on boards without an XIP-specific script.
    linker_script = default_linker_script
  }
  configs = [ "//build/boards/${board}:kernel_config" ]
}
