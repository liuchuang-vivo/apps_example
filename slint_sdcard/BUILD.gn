import("//build/boards/${board}.gni")
import("//build/templates/reload_autoconf_and_build.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

_slint_sdcard_generated = "${target_gen_dir}/slint_sdcard_main_window.rs"

action("generate_slint_sdcard") {
  script = "//build/scripts/run_slint_cli.py"
  inputs = [ "app.slint" ]
  outputs = [ _slint_sdcard_generated ]
  args = [
    "--embed-resources",
    "software-renderer",
    "--output",
    rebase_path(_slint_sdcard_generated),
    rebase_path(inputs[0]),
  ]
}

reload_autoconf_and_build("slint_sdcard_example") {
  app_conf = [ "app.conf" ]
  crate_name = "slint_sdcard_example"
  crate_type = "bin"

  sources = [ "src/main.rs" ]
  inputs = [
    _slint_sdcard_generated,
    "src/math.rs",
  ]
  rustenv = [ "SLINT_SDCARD_GENERATED=" + rebase_path(_slint_sdcard_generated) ]
  deps = [
    ":generate_slint_sdcard",
    "//external/vendor/libm-0.2.16:libm",
    "//external/vendor/png-0.18.1:png",
    "//external/vendor/slint-1.17.1:slint",
    "//kernel/rsrt:rsrt_std",
    "//libc",
    "//librs",
  ]
  linker_script = default_linker_script
  configs = [ "//build/boards/${board}:kernel_config" ]
}
