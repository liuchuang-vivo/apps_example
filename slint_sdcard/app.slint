// SD card file browser UI for the 480x480 round CO5300 AMOLED panel.
// Keep this compatible with SoftwareRenderer::render_by_line: no Path items.
import "assets/website-text.ttf";
import { WebsiteGlyphs } from "assets/website-glyphs.slint";

export struct FileEntry {
    name: string,
    is-dir: bool,
    can-open: bool,
    is-image: bool,
    size-text: string,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> available: true;
    callback activated();
    background: !available ? #182a30 : touch.pressed ? #326e5b : #215743;
    border-width: 1px;
    border-color: available ? #4a9d80 : #263a40;
    border-radius: 9px;
    Text {
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.available ? #edfff7 : #647c80;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        enabled: root.available;
        // Release before changing the reused row model or navigating to another page.
        clicked => { root.activated(); }
    }
}

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: #091217;
    default-font-family: "BlueOS Website Text";
    // Three raster sizes keep the expanded Chinese glyph set within the Flash mapping.
    default-font-size: 18px;

    in property <[FileEntry]> entries;
    in-out property <string> path-text: "/";
    in-out property <string> status-text: "Reading SD card";
    in-out property <int> total-count: 0;
    in-out property <int> visible-count: 0;
    in-out property <int> scroll-offset: 0;
    in-out property <bool> read-error: false;
    in-out property <bool> text-viewer-open: false;
    in-out property <string> text-viewer-title: "";
    in-out property <string> text-viewer-path: "";
    // Dynamic SD text needs a compile-time seed for software-renderer glyph embedding.
    // This hidden initial value is replaced with the first page when opening a TXT.
    in-out property <string> text-viewer-content: WebsiteGlyphs.characters;
    in-out property <string> text-viewer-page: "";
    in-out property <bool> text-viewer-has-previous: false;
    in-out property <bool> text-viewer-has-next: false;
    in-out property <bool> image-viewer-open: false;
    in-out property <string> image-viewer-title: "";
    in-out property <string> image-viewer-path: "";
    in-out property <string> image-viewer-status: "";

    callback entry-selected(int);
    callback up-requested();
    callback refresh-requested();
    callback scroll-up();
    callback scroll-down();
    callback close-text-viewer();
    callback previous-text-page();
    callback next-text-page();
    callback close-image-viewer();

    // Keep the persistent list model, but neither paint nor hit-test it under a viewer.
    browser-page := Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        visible: !root.text-viewer-open && !root.image-viewer-open;
        background: #091217;

        browser-header := Rectangle {
            x: 0px; y: 0px;
            width: parent.width;
            height: 86px;
            background: #101f27;
            Text {
                x: 108px; y: 32px; width: 160px; height: 48px;
                text: "SD CARD";
                color: #f1f8f6;
                font-size: 24px;
                vertical-alignment: center;
            }
            up-button := ActionButton {
                x: 282px; y: 32px; width: 76px; height: 48px;
                label: "UP";
                activated => { root.up-requested(); }
            }
        }
        Rectangle {
            x: 64px; y: 94px; width: 282px; height: 40px;
            background: #102027;
            border-radius: 9px;
            Text {
                x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
                text: root.path-text;
                color: #bed5ce;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        ActionButton {
            x: 356px; y: 94px; width: 60px; height: 40px;
            label: "⟳";
            activated => { root.refresh-requested(); }
        }

        if root.total-count == 0: Rectangle {
            x: 64px; y: 144px; width: 352px; height: 256px;
            background: #0d1a20;
            border-radius: 11px;
            Text {
                x: 0px; y: 72px; width: parent.width; height: 48px;
                text: root.read-error ? "UNAVAILABLE" : "EMPTY";
                color: root.read-error ? #f59c91 : #9cbab3;
                font-size: 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: 16px; y: 132px; width: 320px; height: 96px;
                text: root.status-text;
                color: #aac0c2;
                font-size: 18px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        for entry[index] in root.entries: Rectangle {
            x: 64px; y: 144px + index * 52px; width: 352px; height: 48px;
            background: entry-area.pressed ? #295344 : #102027;
            border-width: 1px;
            border-color: #29413e;
            border-radius: 8px;
            Rectangle {
                x: 10px; y: 12px; width: 26px; height: 26px;
                background: entry.is-dir ? #2a5c50 : entry.is-image ? #3b405f : #274b50;
                border-radius: 7px;
                Text {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    text: entry.is-dir ? "D" : entry.is-image ? "P" : entry.can-open ? "T" : "F";
                    color: #e6fff2;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 46px; y: 1px; width: 294px; height: 28px;
                text: entry.name;
                color: #f0f8f4;
                font-size: 18px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 46px; y: 27px; width: 294px; height: 20px;
                text: entry.is-dir ? "Directory" : entry.size-text + (entry.can-open ? "  /  " + (entry.is-image ? "PNG" : "TXT") : "");
                color: #a4c7ba;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
            entry-area := TouchArea {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                clicked => { root.entry-selected(index); }
            }
        }
        Text {
            x: 124px; y: 412px; width: 88px; height: 44px;
            text: root.total-count > 0 ? (root.scroll-offset + 1) + "-" + (root.scroll-offset + root.visible-count) + "/" + root.total-count : "0";
            color: #b8cdc5;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        ActionButton {
            x: 218px; y: 410px; width: 60px; height: 44px;
            label: "▲";
            available: root.scroll-offset > 0;
            activated => { root.scroll-up(); }
        }
        ActionButton {
            x: 286px; y: 410px; width: 60px; height: 44px;
            label: "▼";
            available: root.scroll-offset + root.visible-count < root.total-count;
            activated => { root.scroll-down(); }
        }
    }

    text-page := Rectangle {
        x: 0px; y: 0px;
        visible: root.text-viewer-open;
        width: parent.width; height: parent.height;
        background: #091217;
        // Consume events instead of passing them to the directory underneath.
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
        text-header := Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: 86px;
            background: #101f27;
            Text {
                x: 106px; y: 32px; width: 174px; height: 48px;
                text: "TXT READER";
                color: #f1f8f6;
                font-size: 24px;
                vertical-alignment: center;
            }
            text-back-button := ActionButton {
                x: 282px; y: 32px; width: 76px; height: 48px;
                label: "BACK";
                activated => { root.close-text-viewer(); }
            }
        }
        Rectangle {
            x: 64px; y: 94px; width: 352px; height: 40px;
            background: #102027;
            border-radius: 9px;
            Text {
                x: 14px; y: 0px; width: 324px; height: parent.height;
                text: root.text-viewer-title;
                color: #e6f0ed;
                font-size: 18px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle {
            x: 56px; y: 140px; width: 368px; height: 266px;
            background: #0d1a20;
            border-radius: 11px;
            Text {
                x: 14px; y: 8px; width: 340px; height: 250px;
                text: root.text-viewer-content;
                color: #edf5f1;
                font-size: 18px;
                vertical-alignment: top;
                // Rust paginates using the same font metrics. Never wrap a second time.
                wrap: no-wrap;
            }
        }
        Text {
            x: 126px; y: 410px; width: 86px; height: 44px;
            text: root.text-viewer-page;
            color: #b8cdc5;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        ActionButton {
            x: 218px; y: 410px; width: 60px; height: 44px;
            label: "<";
            available: root.text-viewer-has-previous;
            activated => { root.previous-text-page(); }
        }
        ActionButton {
            x: 286px; y: 410px; width: 60px; height: 44px;
            label: ">";
            available: root.text-viewer-has-next;
            activated => { root.next-text-page(); }
        }
    }

    image-page := Rectangle {
        x: 0px; y: 0px;
        visible: root.image-viewer-open;
        width: parent.width; height: parent.height;
        background: #091217;
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
        image-header := Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: 82px;
            background: #101f27;
            Text {
                x: 102px; y: 32px; width: 176px; height: 48px;
                text: root.image-viewer-title;
                color: #f1f8f6;
                font-size: 18px;
                vertical-alignment: center;
                overflow: elide;
            }
            image-back-button := ActionButton {
                x: 282px; y: 32px; width: 76px; height: 48px;
                label: "BACK";
                activated => { root.close-image-viewer(); }
            }
        }
        // Keep this geometry synchronized with the streaming RGB565 writer in main.rs.
        Rectangle {
            x: 52px; y: 84px; width: 376px; height: 342px;
            background: #05090c;
            border-width: 1px;
            border-color: #29334d;
            border-radius: 11px;
            clip: true;
        }
        Text {
            x: 150px; y: 428px; width: 180px; height: 28px;
            text: root.image-viewer-status;
            color: #b8c4df;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
