// SD card file browser UI for the 480x480 CO5300 AMOLED panel.
// Keep this compatible with SoftwareRenderer::render_by_line: no Path items.

export struct FileEntry {
    name: string,
    is-dir: bool,
    can-open: bool,
    is-image: bool,
    size-text: string,
}

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: #091217;
    default-font-size: 11px;

    in property <[FileEntry]> entries;
    in-out property <string> path-text: "/";
    in-out property <string> status-text: "Reading SD card";
    in-out property <int> total-count: 0;
    in-out property <int> visible-count: 0;
    in-out property <int> scroll-offset: 0;
    in-out property <bool> read-error: false;
    in-out property <bool> text-viewer-open: false;
    in-out property <string> text-viewer-title: "";
    in-out property <string> text-viewer-path: "";
    in-out property <string> text-viewer-content: "";
    in-out property <string> text-viewer-page: "";
    in-out property <bool> text-viewer-has-previous: false;
    in-out property <bool> text-viewer-has-next: false;
    in-out property <bool> image-viewer-open: false;
    in-out property <string> image-viewer-title: "";
    in-out property <string> image-viewer-path: "";
    in-out property <string> image-viewer-status: "";

    callback entry-selected(int);
    callback up-requested();
    callback refresh-requested();
    callback scroll-up();
    callback scroll-down();
    callback close-text-viewer();
    callback previous-text-page();
    callback next-text-page();
    callback close-image-viewer();

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 82px;
        background: #101f27;

        Rectangle {
            x: 20px;
            y: 18px;
            width: 5px;
            height: 46px;
            background: #4bd6a2;
            border-radius: 2px;
        }

        Text {
            x: 38px;
            y: 12px;
            width: 250px;
            height: 31px;
            text: "SD CARD";
            color: #f1f8f6;
            font-size: 22px;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            x: 39px;
            y: 45px;
            width: 250px;
            height: 18px;
            text: "ESP32-C6  /  FAT32 VOLUME";
            color: #78929b;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            x: 348px;
            y: 18px;
            width: 54px;
            height: 46px;
            background: up-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: #3a806d;
            border-radius: 9px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "UP";
                color: #d9fff2;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            up-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.up-requested();
                    }
                }
            }
        }

        Rectangle {
            x: 410px;
            y: 18px;
            width: 54px;
            height: 46px;
            background: refresh-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: #3a806d;
            border-radius: 9px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "⟳";
                color: #d9fff2;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            refresh-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.refresh-requested();
                    }
                }
            }
        }
    }

    Rectangle {
        x: 16px;
        y: 94px;
        width: 448px;
        height: 40px;
        background: #102027;
        border-width: 1px;
        border-color: #203740;
        border-radius: 9px;

        Rectangle {
            x: 12px;
            y: 11px;
            width: 18px;
            height: 18px;
            background: #2a5c50;
            border-radius: 4px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "F";
                color: #d9fff2;
                font-size: 8px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 40px;
            y: 11px;
            width: 392px;
            height: 18px;
            text: root.path-text;
            color: #e6f0ed;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.total-count == 0: Rectangle {
        x: 16px;
        y: 144px;
        width: 448px;
        height: 280px;
        background: #0d1a20;
        border-width: 1px;
        border-color: #1d3038;
        border-radius: 11px;

        Text {
            x: 0;
            y: 110px;
            width: parent.width;
            height: 50px;
            text: root.read-error ? "UNAVAILABLE" : "EMPTY";
            color: root.read-error ? #cc675f : #3f5c65;
            font-size: 25px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 30px;
            y: 166px;
            width: 388px;
            height: 24px;
            text: root.status-text;
            color: #849aa1;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    for entry[index] in root.entries: Rectangle {
        x: 16px;
        y: 144px + index * 42px;
        width: 448px;
        height: 38px;
        background: entry-area.pressed ? #1b353d : #102027;
        border-width: 1px;
        border-color: #1e333b;
        border-radius: 7px;

        Rectangle {
            x: 10px;
            y: 8px;
            width: 22px;
            height: 22px;
            background: entry.is-dir ? #2a5c50 : entry.is-image ? #3b405f : entry.can-open ? #274b50 : #25353b;
            border-radius: 11px;

            Text {
                width: parent.width;
                height: parent.height;
                text: entry.is-dir ? "D" : entry.is-image ? "P" : entry.can-open ? "T" : "F";
                color: entry.is-dir || entry.can-open ? #d9fff2 : #82969c;
                font-size: 8px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 43px;
            y: 3px;
            width: 290px;
            height: 19px;
            text: entry.name;
            color: #edf6f3;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 43px;
            y: 20px;
            width: 290px;
            height: 15px;
            text: entry.is-dir ? "Directory" : entry.can-open ? entry.size-text + "  |  " + (entry.is-image ? "VIEW" : "TAP") : entry.size-text;
            color: entry.is-dir || entry.can-open ? #62d4ad : #70878e;
            font-size: 8px;
            vertical-alignment: center;
            overflow: elide;
        }

        entry-area := TouchArea {
            // Navigate only after the finger is released. Updating the reused row model on
            // pointer-down would carry this TouchArea's pressed state into the new directory.
            clicked => {
                root.entry-selected(index);
            }
        }
    }

    Rectangle {
        x: 0;
        y: 434px;
        width: parent.width;
        height: 46px;
        background: #101f27;

        Text {
            // Keep footer content inside the round panel's bottom safe area.
            x: 146px;
            y: 3px;
            width: 76px;
            height: 20px;
            text: root.total-count > 0 ? (root.scroll-offset + 1) + " - " + (root.scroll-offset + root.visible-count) + " / " + root.total-count : root.status-text;
            color: #718990;
            font-size: 8px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 230px;
            y: 0px;
            width: 48px;
            height: 32px;
            background: scroll-up-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: #3a806d;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "▲";
                color: #d9fff2;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            scroll-up-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.scroll-up();
                    }
                }
            }
        }

        Rectangle {
            x: 286px;
            y: 0px;
            width: 48px;
            height: 32px;
            background: scroll-down-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: #3a806d;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "▼";
                color: #d9fff2;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            scroll-down-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.scroll-down();
                    }
                }
            }
        }
    }

    Rectangle {
        visible: root.text-viewer-open;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #091217;

        // Prevent the file browser underneath from receiving events while the viewer is open.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 78px;
            background: #101f27;

            Text {
                x: 142px;
                y: 14px;
                width: 134px;
                height: 48px;
                text: "TXT VIEWER";
                color: #f1f8f6;
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
            }

            Rectangle {
                x: 284px;
                y: 18px;
                width: 62px;
                height: 42px;
                background: close-viewer-area.pressed ? #2a5c50 : #1f4f45;
                border-width: 1px;
                border-color: #3a806d;
                border-radius: 9px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "BACK";
                    color: #d9fff2;
                    font-size: 10px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-viewer-area := TouchArea {
                    clicked => {
                        root.close-text-viewer();
                    }
                }
            }
        }

        Rectangle {
            x: 62px;
            y: 86px;
            width: 356px;
            height: 42px;
            background: #102027;
            border-width: 1px;
            border-color: #203740;
            border-radius: 9px;

            Text {
                x: 14px;
                y: 4px;
                width: 328px;
                height: 18px;
                text: root.text-viewer-title;
                color: #e6f0ed;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 14px;
                y: 21px;
                width: 328px;
                height: 16px;
                text: root.text-viewer-path;
                color: #70878e;
                font-size: 8px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            x: 62px;
            y: 136px;
            width: 356px;
            height: 274px;
            background: #0d1a20;
            border-width: 1px;
            border-color: #1d3038;
            border-radius: 11px;

            Text {
                x: 14px;
                y: 12px;
                width: 328px;
                height: 250px;
                text: root.text-viewer-content;
                color: #dce9e5;
                font-size: 10px;
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }

        Text {
            x: 142px;
            y: 424px;
            width: 78px;
            height: 42px;
            text: root.text-viewer-page;
            color: #718990;
            font-size: 8px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 230px;
            y: 424px;
            width: 48px;
            height: 42px;
            background: !root.text-viewer-has-previous ? #182a30 : previous-page-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: root.text-viewer-has-previous ? #3a806d : #263a40;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "<";
                color: root.text-viewer-has-previous ? #d9fff2 : #53676d;
                font-size: 13px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            previous-page-area := TouchArea {
                enabled: root.text-viewer-has-previous;
                clicked => {
                    root.previous-text-page();
                }
            }
        }

        Rectangle {
            x: 286px;
            y: 424px;
            width: 48px;
            height: 42px;
            background: !root.text-viewer-has-next ? #182a30 : next-page-area.pressed ? #2a5c50 : #1f4f45;
            border-width: 1px;
            border-color: root.text-viewer-has-next ? #3a806d : #263a40;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: ">";
                color: root.text-viewer-has-next ? #d9fff2 : #53676d;
                font-size: 13px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            next-page-area := TouchArea {
                enabled: root.text-viewer-has-next;
                clicked => {
                    root.next-text-page();
                }
            }
        }
    }

    Rectangle {
        visible: root.image-viewer-open;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #091217;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 78px;
            background: #101f27;

            Text {
                x: 112px;
                y: 7px;
                width: 166px;
                height: 30px;
                text: "PNG VIEWER";
                color: #f1f8f6;
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
            }

            Text {
                x: 112px;
                y: 39px;
                width: 166px;
                height: 20px;
                text: root.image-viewer-title;
                color: #747e9c;
                font-size: 9px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 284px;
                y: 18px;
                width: 62px;
                height: 42px;
                background: close-image-area.pressed ? #454b70 : #343957;
                border-width: 1px;
                border-color: #646c9b;
                border-radius: 9px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "BACK";
                    color: #eef0ff;
                    font-size: 10px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-image-area := TouchArea {
                    clicked => {
                        root.close-image-viewer();
                    }
                }
            }
        }

        Rectangle {
            x: 52px;
            y: 84px;
            width: 376px;
            height: 342px;
            background: #05090c;
            border-width: 1px;
            border-color: #29334d;
            border-radius: 11px;
            clip: true;
        }

        Text {
            x: 108px;
            y: 432px;
            width: 264px;
            height: 28px;
            text: root.image-viewer-status;
            color: #747e9c;
            font-size: 9px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
