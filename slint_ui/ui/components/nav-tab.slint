// Bottom navigation tab component
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "theme.slint";

export component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> accent: #6fe0bd;
    width: 240px; height: 48px;
    background: root.active ? Theme.raised-background : Theme.surface-background;

    Text {
        x: 0; y: 0; width: parent.width; height: 28px;
        text: root.label;
        color: root.active ? root.accent : Theme.muted-text;
        font-size: Theme.font-base; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle {
        x: 80px; y: 30px; width: 80px; height: 3px;
        background: root.active ? root.accent : transparent;
        border-radius: 1px;
    }

    callback clicked;
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}
