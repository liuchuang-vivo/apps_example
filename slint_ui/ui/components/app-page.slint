// Reusable swipe container for app screens.
// Each app page inherits from this component.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "theme.slint";

export component AppPage inherits Rectangle {
    in property <string> title;
    in property <color> accent;
    in property <string> subtitle: "";
    in property <string> action-text: "";
    in property <bool> action-disabled: false;
    callback go-back();
    callback action-clicked();

    background: transparent;

    // Swipe-right gesture to go back
    touch-gesture := TouchArea {
        width: parent.width;
        height: parent.height;
        property <length> start-x: 0;
        property <bool> tracking: false;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start-x = self.mouse-x;
                self.tracking = true;
            }
            if event.kind == PointerEventKind.up && self.tracking {
                if self.mouse-x > self.start-x + 60px {
                    root.go-back();
                }
                self.tracking = false;
            }
        }
    }

    // Title bar (WifiScanPage style)
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 82px;
        background: Theme.surface-background;

        Rectangle {
            x: 0;
            y: 0;
            width: 48px;
            height: parent.height;
            background: back-area.pressed ? Theme.pressed-background : transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: "←";
                color: root.accent;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            back-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.go-back(); }
            }
        }

        Rectangle {
            x: 52px;
            y: 18px;
            width: 5px;
            height: 46px;
            background: root.accent;
            border-radius: 2px;
        }

        Text {
            x: 70px;
            y: root.subtitle != "" ? 12px : 0;
            width: root.action-text != "" ? 260px : 380px;
            height: root.subtitle != "" ? 31px : parent.height;
            text: root.title;
            color: Theme.primary-text;
            font-size: 22px;
            font-weight: 800;
            vertical-alignment: center;
        }

        if root.subtitle != "" : Text {
            x: 71px;
            y: 45px;
            width: root.action-text != "" ? 260px : 380px;
            height: 18px;
            text: root.subtitle;
            color: Theme.muted-text;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if root.action-text != "" : Rectangle {
            x: 348px;
            y: 18px;
            width: 112px;
            height: 46px;
            background: root.action-disabled ? Theme.raised-background : action-area.pressed ? Theme.pressed-background : Theme.raised-background;
            border-width: 1px;
            border-color: root.action-disabled ? Theme.border-color : root.accent;
            border-radius: 9px;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.action-text;
                color: root.action-disabled ? Theme.muted-text : root.accent;
                font-size: 10px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            action-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && !root.action-disabled {
                        root.action-clicked();
                    }
                }
            }
        }

        Rectangle {
            x: 0;
            y: 81px;
            width: parent.width;
            height: 1px;
            background: Theme.divider-color;
        }
    }
}
