// Reusable swipe container for app screens.
// Each app page inherits from this component.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

export component AppPage inherits Rectangle {
    in property <string> title;
    in property <color> accent;
    callback go-back();

    background: #0b1115;

    // Swipe-right gesture to go back
    touch-gesture := TouchArea {
        width: parent.width;
        height: parent.height;
        property <length> start-x: 0;
        property <bool> tracking: false;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start-x = self.mouse-x;
                self.tracking = true;
            }
            if event.kind == PointerEventKind.up && self.tracking {
                if self.mouse-x > self.start-x + 60px {
                    root.go-back();
                }
                self.tracking = false;
            }
        }
    }

    // Title bar
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 52px;
        background: #11171b;

        Rectangle {
            x: 0;
            y: 0;
            width: 48px;
            height: 52px;

            Text {
                x: 8px;
                y: 8px;
                width: 36px;
                height: 36px;
                text: "←";
                color: root.accent;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            back-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.go-back(); }
            }
        }

        Text {
            x: 48px;
            y: 0;
            width: parent.width - 48px;
            height: parent.height;
            text: root.title;
            color: #f3f6f7;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            x: 0;
            y: 51px;
            width: parent.width;
            height: 1px;
            background: #283036;
        }
    }
}