// Reusable swipe container for app screens.
// Each app page inherits from this component.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { GestureLayer } from "gesture-layer.slint";

export component AppPage inherits Rectangle {
    in property <string> title;
    in property <color> accent;
    in property <string> nav-home-text: "主页";
    in property <string> nav-back-text: "返回";
    callback go-back();
    callback go-home();
    // Full-screen swipe gestures — pages can bind these as needed.
    // Taps (<20px both axes) are ignored so content TouchAreas work naturally.
    callback swipe-left(float, float);
    callback swipe-right(float, float);
    callback swipe-up(float, float);
    callback swipe-down(float, float);
    callback tap(float, float);
    callback press(float, float);
    callback release();
    // Allow sub-pages to disable the gesture layer (e.g. brightness slider).
    in property <bool> gesture-enabled: true;
    callback gesture-debug(string);

    background: Theme.screen-background;

    // Full-screen gesture layer placed behind content.
    // Slint routes press events to the z-topmost TouchArea first, so buttons
    // and other interactive elements in page content are unaffected.
    gesture-layer := GestureLayer {
        width: parent.width;
        height: parent.height;
        enabled: root.gesture-enabled;
        swipe-left(dx, dy) => { root.swipe-left(dx, dy); }
        swipe-right(dx, dy) => { root.swipe-right(dx, dy); }
        swipe-up(dx, dy) => { root.swipe-up(dx, dy); }
        swipe-down(dx, dy) => { root.swipe-down(dx, dy); }
        tap(mx, my) => { root.tap(mx, my); }
        press(mx, my) => { root.press(mx, my); }
        release() => { root.release(); }
        debug(msg) => { root.gesture-debug(msg); }
    }

    // Title bar
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 60px;
        background: Theme.surface-background;

        Text {
            x: 0;
            width: parent.width;
            height: parent.height;
            text: root.title;
            color: Theme.primary-text;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: 0;
            y: 59px;
            width: parent.width;
            height: 1px;
            background: Theme.divider-color;
        }
    }

    // Bottom navigation bar
    Rectangle {
        x: 0;
        y: parent.height - 56px;
        width: parent.width;
        height: 56px;
        background: Theme.surface-background;

        Rectangle {
            x: 0; y: 0; width: parent.width; height: 1px;
            background: Theme.divider-color;
        }

        // Left button: home icon + label horizontally centred in 240px × 55px
        Rectangle {
            x: 0; y: 1px;
            width: 240px; height: 55px;

            background: home-area.pressed ? Theme.pressed-background : transparent;

            HorizontalLayout {
                width: 106px;
                height: parent.height;
                x: (parent.width - self.width) / 2;
                alignment: center;

                Text {
                    text: Icons.home;
                    color: Theme.primary-text;
                    font-family: Theme.icon-font-family;
                    font-size: Theme.font-nav-icon;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { width: 4px; }
                Text {
                    text: root.nav-home-text;
                    color: Theme.primary-text;
                    font-size: Theme.font-base;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Placed outside the HorizontalLayout so width: parent.width refers
            // to the 240px button Rectangle, giving the TouchArea the full
            // button hit area instead of the leftover space after the icon/label.
            home-area := TouchArea {
                width: parent.width; height: parent.height;
                clicked => { root.go-home(); }
            }
        }

        // Right button: back icon + label horizontally centred in 240px × 55px
        // nav-back-text can be "返回" (2 chars), "上一层" (3 chars) or "退出" (2 chars).
        Rectangle {
            x: 240px; y: 1px;
            width: 240px; height: 55px;

            background: back-area-btm.pressed ? Theme.pressed-background : transparent;

            HorizontalLayout {
                width: 136px;
                height: parent.height;
                x: (parent.width - self.width) / 2;
                alignment: center;

                Text {
                    text: Icons.back;
                    color: Theme.primary-text;
                    font-family: Theme.icon-font-family;
                    font-size: Theme.font-back-icon;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { width: 4px; }
                Text {
                    text: root.nav-back-text;
                    color: Theme.primary-text;
                    font-size: Theme.font-base;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Placed outside the HorizontalLayout so width: parent.width refers
            // to the 240px button Rectangle, giving the TouchArea the full
            // button hit area instead of the leftover space after the icon/label.
            back-area-btm := TouchArea {
                width: parent.width; height: parent.height;
                clicked => { root.go-back(); }
            }
        }

        // Divider between nav buttons
        Rectangle {
            x: 239px; y: 8px;
            width: 1px; height: 40px;
            background: Theme.divider-color;
        }
    }
}