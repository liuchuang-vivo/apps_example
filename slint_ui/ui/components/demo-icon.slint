// Demo app icon for the launcher grid
// Compatible with SoftwareRenderer::render_by_line: no Path items.

export component DemoIcon inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <color> accent: #5ca9ff;

    width: 120px; height: 140px;

    Rectangle {
        x: 20px; y: 0;
        width: 80px; height: 80px;
        background: #121b20;
        border-width: 1px;
        border-color: touch-area.pressed ? root.accent : #293239;
        border-radius: 16px;

        Text {
            width: parent.width; height: parent.height;
            text: root.icon-text;
            color: root.accent;
            font-size: 36px; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    Text {
        x: 0; y: 92px;
        width: parent.width; height: 48px;
        text: root.label;
        color: #93a6a8;
        font-size: 11px; font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: top;
        overflow: elide;
    }

    callback clicked;
    touch-area := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.clicked(); }
    }
}