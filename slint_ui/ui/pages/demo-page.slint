// Placeholder demo page for kernel demos
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { AppPage } from "../components/app-page.slint";

export component DemoPage inherits AppPage {
    in property <string> desc: "To be implemented";

    Rectangle {
        x: 20px; y: 76px;
        width: 440px; height: 380px;
        background: #121b20;
        border-width: 1px; border-color: #293239; border-radius: 8px;

        Text {
            x: 0; y: 100px; width: parent.width; height: 40px;
            text: root.desc;
            color: #93a6a8; font-size: 18px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }

        Text {
            x: 0; y: 150px; width: parent.width; height: 30px;
            text: "⋮ ⋮ ⋮";
            color: root.accent; font-size: 32px; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
