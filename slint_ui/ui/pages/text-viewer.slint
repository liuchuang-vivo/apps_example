// Text viewer for .txt files in SD card browser.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "../components/theme.slint";

export component TextViewer inherits Rectangle {
    in property <string> text-title;
    in property <string> text-content;
    in property <string> text-page;
    callback close-text();

    background: Theme.screen-background;

    // Title bar — left: filename, right: page number
    Text {
        x: 16px; y: 6px; width: 340px; height: 28px;
        text: root.text-title;
        color: Theme.primary-text;
        font-size: Theme.font-base;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 362px; y: 6px; width: 102px; height: 28px;
        text: root.text-page;
        color: Theme.muted-text;
        font-size: Theme.font-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Divider
    Rectangle {
        x: 0px; y: 38px; width: parent.width; height: 1px;
        background: Theme.divider-color;
    }

    // Text content
    Text {
        x: 16px; y: 50px; width: 448px; height: parent.height - 50px;
        text: root.text-content;
        color: Theme.primary-text;
        font-family: Theme.text-font-family;
        font-size: Theme.font-base;
        vertical-alignment: top;
        wrap: no-wrap;
    }
}