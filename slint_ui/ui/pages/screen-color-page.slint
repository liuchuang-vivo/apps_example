// LCD primary-color test page.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component ScreenColorPage inherits AppPage {
    title: "LCM 三基色";
    accent: #ffffff;

    property <int> selected-color: 0;
    property <color> test-color: selected-color == 0 ? #ff0000 : selected-color == 1 ? #00ff00 : #0000ff;

    // The content area shows the selected LCM primary color directly.
    Rectangle {
        x: 0px; y: 60px;
        width: parent.width; height: 364px;
        background: root.test-color;

        // One button cycles through red, green, and blue in order.
        Rectangle {
            x: 122px; y: 194px; width: 236px; height: 58px;
            background: next-color-area.pressed ? Theme.pressed-background : Theme.raised-background;
            border-radius: 10px;
            Text {
                width: parent.width; height: parent.height;
                text: root.selected-color == 0 ? "切换到绿色" : root.selected-color == 1 ? "切换到蓝色" : "切换到红色";
                color: #ffffff; font-size: Theme.font-base; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
            next-color-area := TouchArea {
                width: parent.width; height: parent.height;
                clicked => { root.selected-color = root.selected-color == 2 ? 0 : root.selected-color + 1; }
            }
        }
    }
}
