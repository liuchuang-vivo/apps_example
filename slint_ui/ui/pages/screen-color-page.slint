// Global screen-theme control.
// The light palette comes from the colleague's original Slint example.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component ScreenColorPage inherits AppPage {
    title: "屏幕变色";
    accent: Theme.accent-color;

    // Color preview card
    Rectangle {
        x: 100px; y: 136px; width: 280px; height: 76px;
        background: Theme.screen-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 10px;

        Rectangle { x: 14px; y: 14px; width: 48px; height: 48px; background: Theme.accent-color; border-radius: 8px; }
        Text {
            x: 76px; y: 0; width: 180px; height: parent.height;
            text: Theme.theme-name == "vivo" ? "深蓝" : "深青";
            color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 800;
            vertical-alignment: center;
        }
    }

    // Switch button
    Rectangle {
        x: 100px; y: 236px; width: 280px; height: 58px;
        background: Theme.raised-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 12px;

        Text {
            width: parent.width; height: parent.height;
            text: Theme.theme-name == "vivo" ? "切换到深青" : "切换到深蓝";
            color: Theme.accent-color; font-size: Theme.font-lg; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
        }

        switch-area := TouchArea {
            width: parent.width; height: parent.height;
            clicked => { Theme.theme-name = Theme.theme-name == "default" ? "vivo" : "default"; }
        }
    }

    Text {
        x: 40px; y: 322px; width: 400px; height: 28px;
        text: "配色会应用到主页和所有功能页面";
        color: Theme.muted-text; font-size: Theme.font-base;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
