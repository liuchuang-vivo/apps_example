// PNG image viewer for SD card browser.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "../components/theme.slint";

export component ImageViewer inherits Rectangle {
    in property <string> image-title;
    in property <string> image-status;
    callback close-image();

    background: #0b1115;

    // Title bar — left: filename, right: image status
    Text {
        x: 16px; y: 6px; width: 340px; height: 28px;
        text: root.image-title;
        color: Theme.primary-text;
        font-size: Theme.font-base;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 362px; y: 6px; width: 102px; height: 28px;
        text: root.image-status;
        color: Theme.muted-text;
        font-size: Theme.font-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Image area
    Rectangle {
        x: 105px; y: 60px; width: 270px; height: 270px;
        background: #05090c;
        border-width: 1px;
        border-color: #29334d;
        border-radius: 0px;
    }
}