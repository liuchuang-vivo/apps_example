// Wi-Fi scan UI integrated into the launcher.
// Content directly on screen-background, no card boxes.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export struct WifiNetwork {
    ssid: string,
    detail: string,
    signal-text: string,
    strength: int,
    secure: bool,
}

export component WifiScanPage inherits AppPage {
    title: "Wi-Fi 扫描";
    accent: #4bd6a2;

    in property <[WifiNetwork]> networks;
    in-out property <bool> scanning: false;
    in-out property <int> result-count: 0;
    in-out property <int> current-page: 0;
    in-out property <int> total-pages: 0;
    in-out property <string> status-text: "正在准备无线扫描";
    callback scan-requested();

    // Status area: one-line status + scan button
    Text {
        x: 18px; y: 73px; width: 310px; height: 34px;
        text: root.scanning ? "正在扫描..." : root.result-count > 0 ? "扫描到 " + root.result-count + " 个网络" : "未扫描到网络";
        color: root.scanning ? #d5b95e : root.result-count > 0 ? Theme.primary-text : Theme.muted-text;
        font-size: Theme.font-base; font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    // Scan button
    Rectangle {
        x: 350px; y: 70px; width: 110px; height: 42px;
        background: scan-area.pressed ? Theme.pressed-background : Theme.raised-background;
        border-width: 1px; border-color: root.scanning ? Theme.border-color : root.accent;
        border-radius: 9px;

        Text {
            width: parent.width; height: parent.height;
            text: root.scanning ? "扫描中..." : "重新扫描";
            color: root.scanning ? Theme.muted-text : root.accent;
            font-size: Theme.font-sm; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
        }

        scan-area := TouchArea {
            width: parent.width; height: parent.height;
            clicked => { if !root.scanning { root.scan-requested(); } }
        }
    }

    // Empty state (shown when no results)
    if root.result-count == 0 : Rectangle {
        x: 0; y: 120px; width: parent.width; height: 250px;

        Text {
            x: 0; y: 40px; width: parent.width; height: 50px;
            text: root.scanning ? "..." : "WI-FI";
            color: root.scanning ? #d5b95e : Theme.muted-text;
            font-size: Theme.font-lg; font-weight: 800;
            horizontal-alignment: center; vertical-alignment: center;
        }

        Text {
            x: 30px; y: 97px; width: 420px; height: 24px;
            text: root.scanning ? "扫描信道 1 至 13" : "点击重新扫描搜索网络";
            color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }

        Text {
            x: 30px; y: 126px; width: 420px; height: 20px;
            text: "SSID、信号、信道和安全信息将显示在此处";
            color: Theme.muted-text; font-size: Theme.font-sm;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    // Network list — starts closer to status line
    for network[index] in root.networks: Rectangle {
        x: 16px; y: 118px + index * 45px; width: 448px; height: 39px;

        // Index number — small text label, no circular background
        Text {
            x: 4px; y: 0; width: 24px; height: parent.height;
            text: index + 1;
            color: #62d4ad; font-size: Theme.font-sm; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }

        Text { x: 34px; y: 3px; width: 250px; height: 19px; text: network.ssid; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; overflow: elide; }

        Text { x: 34px; y: 20px; width: 250px; height: 15px; text: network.detail; color: network.secure ? Theme.secondary-text : #a1832f; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; }

        // Signal strength bars (vertical, from bottom-left of right area)
        Rectangle { x: 298px; y: 24px; width: 4px; height: 5px; background: network.strength >= 1 ? Theme.accent-color : Theme.divider-color; }
        Rectangle { x: 305px; y: 19px; width: 4px; height: 10px; background: network.strength >= 2 ? Theme.accent-color : Theme.divider-color; }
        Rectangle { x: 312px; y: 14px; width: 4px; height: 15px; background: network.strength >= 3 ? Theme.accent-color : Theme.divider-color; }
        Rectangle { x: 319px; y: 9px; width: 4px; height: 20px; background: network.strength >= 4 ? Theme.accent-color : Theme.divider-color; }

        Text { x: 338px; y: 0; width: 98px; height: parent.height; text: network.signal-text; color: network.strength >= 3 ? #6fe0b8 : network.strength == 2 ? #d5b95e : #d07d72; font-size: Theme.font-sm; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
    }

    // Page indicator (mirrors the SD card page: "current/total")
    Text {
        x: 24px; y: 118px + 6 * 45px + 4px; width: 408px; height: 20px;
        visible: root.result-count > 0 && root.total-pages > 1;
        text: root.current-page + "/" + root.total-pages;
        color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 400;
        horizontal-alignment: right; vertical-alignment: center;
    }
}