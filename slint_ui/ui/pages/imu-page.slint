// IMU sensor data page (QMI8658 accelerometer + gyroscope).
// Content directly on screen-background, no card boxes.
// Layout: X/Y/Z values arranged horizontally in one row per sensor,
// so render_by_line dirty regions shrink to ~2 rows per tick instead of
// the 6-row vertical spread that blocked the event loop (~430ms/frame).

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component ImuPage inherits AppPage {
    in property <string> accel-x: "---";
    in property <string> accel-y: "---";
    in property <string> accel-z: "---";
    in property <string> gyro-x: "---";
    in property <string> gyro-y: "---";
    in property <string> gyro-z: "---";

    title: "IMU 传感器";
    accent: #f08091;

    // ====== 加速度计区块 ======
    Rectangle { x: 24px; y: 84px; width: 6px; height: 18px; background: #f08091; border-radius: 3px; }
    Text { x: 38px; y: 80px; width: 200px; height: 26px; text: "加速度计  m/s²"; color: #f08091; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }

    // X / Y / Z horizontally on one row — values left-aligned next to labels
    Text { x: 24px;  y: 120px; width: 24px; height: 36px; text: "X"; color: #fca5a5; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 52px;  y: 120px; width: 96px; height: 36px; text: root.accel-x; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }

    Text { x: 184px; y: 120px; width: 24px; height: 36px; text: "Y"; color: #86efac; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 212px; y: 120px; width: 96px; height: 36px; text: root.accel-y; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }

    Text { x: 344px; y: 120px; width: 24px; height: 36px; text: "Z"; color: #93c5fd; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 372px; y: 120px; width: 80px; height: 36px; text: root.accel-z; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }

    // ====== 陀螺仪区块 ======
    Rectangle { x: 24px; y: 200px; width: 6px; height: 18px; background: #6fe0bd; border-radius: 3px; }
    Text { x: 38px; y: 196px; width: 200px; height: 26px; text: "陀螺仪  °/s"; color: #6fe0bd; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }

    Text { x: 24px;  y: 236px; width: 24px; height: 36px; text: "X"; color: #fca5a5; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 52px;  y: 236px; width: 96px; height: 36px; text: root.gyro-x; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }

    Text { x: 184px; y: 236px; width: 24px; height: 36px; text: "Y"; color: #86efac; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 212px; y: 236px; width: 96px; height: 36px; text: root.gyro-y; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }

    Text { x: 344px; y: 236px; width: 24px; height: 36px; text: "Z"; color: #93c5fd; font-size: Theme.font-base; font-weight: 800; vertical-alignment: center; }
    Text { x: 372px; y: 236px; width: 80px; height: 36px; text: root.gyro-z; color: Theme.primary-text; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; }
}
