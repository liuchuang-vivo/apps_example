// Gold and silver prices fetched through the board's HTTP proxy.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component MetalsPage inherits AppPage {
    in property <string> time: "--:--";
    in property <string> xau: "--";
    in property <string> xag: "--";
    in property <string> net-status: "等待网络";
    callback refresh();

    title: "HTTP GET";
    accent: #5ca9ff;

    Text {
        x: 20px;
        y: 68px;
        width: 270px;
        height: 48px;
        text: "COMEX · USD/oz";
        color: Theme.secondary-text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }

    Rectangle {
        x: 326px;
        y: 70px;
        width: 134px;
        height: 44px;
        background: refresh-area.pressed ? Theme.pressed-background : Theme.raised-background;
        border-width: 1px;
        border-color: root.accent;
        border-radius: 12px;

        Text {
            width: parent.width;
            height: parent.height;
            text: "刷新";
            color: Theme.primary-text;
            font-size: Theme.font-base;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        refresh-area := TouchArea {
            clicked => { root.refresh(); }
        }
    }

    Rectangle {
        x: 20px;
        y: 126px;
        width: 440px;
        height: 88px;
        background: Theme.card-background;
        border-width: 1px;
        border-color: Theme.border-color;
        border-radius: 12px;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.time;
            color: Theme.primary-text;
            font-size: 48px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 20px;
        y: 226px;
        width: 440px;
        height: 70px;
        background: Theme.card-background;
        border-width: 1px;
        border-color: Theme.border-color;
        border-radius: 14px;

        Rectangle {
            x: 20px;
            y: 23px;
            width: 8px;
            height: 24px;
            background: #fbbf24;
            border-radius: 4px;
        }
        Text {
            x: 44px;
            width: 120px;
            height: parent.height;
            text: "Gold";
            color: #fbbf24;
            font-size: Theme.font-base;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 164px;
            width: 252px;
            height: parent.height;
            text: root.xau;
            color: Theme.primary-text;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 20px;
        y: 308px;
        width: 440px;
        height: 70px;
        background: Theme.card-background;
        border-width: 1px;
        border-color: Theme.border-color;
        border-radius: 14px;

        Rectangle {
            x: 20px;
            y: 23px;
            width: 8px;
            height: 24px;
            background: #cbd5e1;
            border-radius: 4px;
        }
        Text {
            x: 44px;
            width: 120px;
            height: parent.height;
            text: "Silver";
            color: #cbd5e1;
            font-size: Theme.font-base;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 164px;
            width: 252px;
            height: parent.height;
            text: root.xag;
            color: Theme.primary-text;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Text {
        x: 20px;
        y: 388px;
        width: 440px;
        height: 26px;
        text: root.net-status;
        color: Theme.muted-text;
        font-size: Theme.font-sm;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
