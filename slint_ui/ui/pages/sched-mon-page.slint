// Scheduler and resource monitoring demo page.
// Shows combined CPU + memory monitor card, and running task list.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component SchedMonPage inherits AppPage {
    in property <int> cpu-cores: 1;
    in property <[float]> cpu-usage-percent;
    in property <float> mem-total-kb: 0.0;
    in property <float> mem-used-kb: 0.0;
    in property <float> mem-max-used-kb: 0.0;
    in property <[string]> task-tids;
    in property <[string]> task-types;
    in property <[string]> task-states;
    in property <[string]> task-prios;
    in property <[string]> task-names;
    in property <int> task-hidden: 0;
    callback refresh-tasks();

    title: "调度与监控";
    accent: #5ca9ff;
    subtitle: "CPU / 内存 / 任务";

    // ====== 1. 监控卡片（CPU + 内存合并在同一张卡片内）======
    Rectangle {
        x: 20px; y: 92px;
        width: 440px; height: 120px;
        background: Theme.card-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 12px;

        Rectangle { x: 16px; y: 14px; width: 6px; height: 18px; background: root.accent; border-radius: 3px; }
        Text { x: 30px; y: 10px; width: 200px; height: 26px; text: "监控"; color: root.accent; font-size: 17px; font-weight: 700; vertical-alignment: center; }

        // CPU bar (single core ESP32-C6)
        Rectangle {
            x: 16px; y: 44px; width: 408px; height: 22px;
            Text { x: 0px; y: 0px; width: 34px; height: 22px; text: "CPU"; color: root.accent; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
            Rectangle {
                x: 38px; y: 4px; width: 310px; height: 14px;
                background: Theme.raised-background; border-radius: 7px;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width * root.cpu-usage-percent[0] / 100.0; height: 14px;
                    background: root.accent; border-radius: 7px;
                }
            }
            Text { x: 354px; y: 0px; width: 54px; height: 22px; text: Math.clamp(Math.round(root.cpu-usage-percent[0]), 0, 100) + "%"; color: Theme.primary-text; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: left; }
        }

        // Memory bar
        Rectangle {
            x: 16px; y: 72px; width: 408px; height: 22px;
            Text { x: 0px; y: 0px; width: 34px; height: 22px; text: "内存"; color: #f0bd62; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
            Rectangle {
                x: 38px; y: 4px; width: 310px; height: 14px;
                background: Theme.raised-background; border-radius: 7px;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width * (root.mem-used-kb / root.mem-total-kb); height: 14px;
                    background: #f0bd62; border-radius: 7px;
                }
            }
            Text { x: 354px; y: 0px; width: 54px; height: 22px; text: (root.mem-total-kb > 0 ? Math.clamp(Math.round(root.mem-used-kb / root.mem-total-kb * 100), 0, 100) : 0) + "%"; color: Theme.primary-text; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: left; }
        }

        // Memory values row: 总计 / 已用 / 峰值
        Text { x: 16px; y: 96px; width: 40px; height: 16px; text: "总计"; color: Theme.muted-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 52px; y: 96px; width: 110px; height: 16px; text: root.mem-total-kb + " kB"; color: Theme.primary-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 170px; y: 96px; width: 40px; height: 16px; text: "已用"; color: Theme.muted-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 206px; y: 96px; width: 110px; height: 16px; text: root.mem-used-kb + " kB"; color: Theme.primary-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 320px; y: 96px; width: 40px; height: 16px; text: "峰值"; color: Theme.muted-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 356px; y: 96px; width: 90px; height: 16px; text: root.mem-max-used-kb + " kB"; color: Theme.primary-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    }

    // ====== 2. 任务列表卡片 ======
    Rectangle {
        x: 20px; y: 224px;
        width: 440px; height: 190px;
        background: Theme.card-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 12px;

        Rectangle { x: 16px; y: 14px; width: 6px; height: 18px; background: #86efac; border-radius: 3px; }
        Text { x: 30px; y: 10px; width: 200px; height: 26px; text: "任务列表"; color: #86efac; font-size: 17px; font-weight: 700; vertical-alignment: center; }

        // ---- 等宽列表 ----
        // Column headers （内容宽 408px = 440 - 16*2）
        // TID(56px) + 类型(60px) + 状态(60px) + 优先级(56px) + 名称(168px) + 间距(8px) = 408px
        Text { x: 16px;  y: 42px; width: 56px;  height: 16px; text: "TID";    color: Theme.muted-text; font-size: 10px; font-weight: 700; }
        Text { x: 74px;  y: 42px; width: 60px;  height: 16px; text: "类型";   color: Theme.muted-text; font-size: 10px; font-weight: 700; }
        Text { x: 136px; y: 42px; width: 60px;  height: 16px; text: "状态";   color: Theme.muted-text; font-size: 10px; font-weight: 700; }
        Text { x: 198px; y: 42px; width: 56px;  height: 16px; text: "优先级"; color: Theme.muted-text; font-size: 10px; font-weight: 700; }
        Text { x: 256px; y: 42px; width: 168px; height: 16px; text: "名称";   color: Theme.muted-text; font-size: 10px; font-weight: 700; }

        // Task rows — 8 rows, each 18px tall
        for idx in 4 : Rectangle {
            x: 16px; y: 60px + idx * 18px;
            width: 408px; height: 16px;

            Text { x: 0px;   width: 56px;  height: parent.height; text: root.task-tids[idx];   color: Theme.secondary-text; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: 58px;  width: 60px;  height: parent.height; text: root.task-types[idx];  color: Theme.secondary-text; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: 120px; width: 60px;  height: parent.height; text: root.task-states[idx]; color: Theme.secondary-text; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: 182px; width: 56px;  height: parent.height; text: root.task-prios[idx];  color: Theme.secondary-text; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: 240px; width: 168px; height: parent.height; text: root.task-names[idx];  color: Theme.secondary-text; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        }

        // "省略 xx 个任务" — bottom of the card
        Text {
            x: 16px; y: 136px; width: 408px; height: 16px;
            visible: root.task-hidden > 0;
            text: "还有 " + root.task-hidden + " 个任务";
            color: Theme.muted-text; font-size: 10px; font-weight: 400;
        }
    }
}