// Scheduler and resource monitoring demo page.
// Shows combined CPU + memory monitor, and running task list.
// Content directly on screen-background, no card boxes.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component SchedMonPage inherits AppPage {
    in property <int> cpu-cores: 1;
    in property <[float]> cpu-usage-percent;
    in property <float> mem-total-kb: 0.0;
    in property <float> mem-used-kb: 0.0;
    in property <float> mem-max-used-kb: 0.0;
    in property <[string]> task-tids;
    in property <[string]> task-types;
    in property <[string]> task-states;
    in property <[string]> task-prios;
    in property <[string]> task-names;
    in property <int> task-hidden: 0;
    callback refresh-tasks();

    title: "调度与监控";
    accent: #5ca9ff;

    // ====== 监控区块 ======
    Rectangle { x: 24px; y: 76px; width: 6px; height: 18px; background: root.accent; border-radius: 3px; }
    Text { x: 38px; y: 72px; width: 200px; height: 26px; text: "监控"; color: root.accent; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }

    // CPU bar (single core ESP32-C6)
    Rectangle {
        x: 24px; y: 106px; width: 432px; height: 22px;
        Text { x: 0px; y: 0px; width: 34px; height: 22px; text: "CPU"; color: root.accent; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
        Rectangle {
            x: 38px; y: 4px; width: 334px; height: 14px;
            background: Theme.raised-background; border-radius: 7px;
            Rectangle {
                x: 0px; y: 0px; width: parent.width * root.cpu-usage-percent[0] / 100.0; height: 14px;
                background: root.accent; border-radius: 7px;
            }
        }
        Text { x: 378px; y: 0px; width: 54px; height: 22px; text: Math.clamp(Math.round(root.cpu-usage-percent[0]), 0, 100) + "%"; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: left; }
    }

    // Memory bar
    Rectangle {
        x: 24px; y: 132px; width: 432px; height: 22px;
        Text { x: 0px; y: 0px; width: 34px; height: 22px; text: "内存"; color: #f0bd62; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
        Rectangle {
            x: 38px; y: 4px; width: 334px; height: 14px;
            background: Theme.raised-background; border-radius: 7px;
            Rectangle {
                x: 0px; y: 0px; width: parent.width * (root.mem-used-kb / root.mem-total-kb); height: 14px;
                background: #f0bd62; border-radius: 7px;
            }
        }
        Text { x: 378px; y: 0px; width: 54px; height: 22px; text: (root.mem-total-kb > 0 ? Math.clamp(Math.round(root.mem-used-kb / root.mem-total-kb * 100), 0, 100) : 0) + "%"; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: left; }
    }

    // Memory values row: 总计 / 已用 / 峰值
    Text { x: 24px; y: 160px; width: 40px; height: 16px; text: "总计"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 60px; y: 160px; width: 110px; height: 16px; text: root.mem-total-kb + " kB"; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 180px; y: 160px; width: 40px; height: 16px; text: "已用"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 216px; y: 160px; width: 110px; height: 16px; text: root.mem-used-kb + " kB"; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 336px; y: 160px; width: 40px; height: 16px; text: "峰值"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 372px; y: 160px; width: 90px; height: 16px; text: root.mem-max-used-kb + " kB"; color: Theme.primary-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }

    // ====== 任务列表区块 ======
    Rectangle { x: 24px; y: 202px; width: 6px; height: 18px; background: #86efac; border-radius: 3px; }
    Text { x: 38px; y: 198px; width: 200px; height: 26px; text: "任务列表"; color: #86efac; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }

    // ---- 等宽列表 ----
    // Column headers — now 20px tall for font-sm (16px)
    Text { x: 24px;  y: 232px; width: 44px;  height: 20px; text: "TID";    color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 70px;  y: 232px; width: 64px;  height: 20px; text: "类型";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 136px; y: 232px; width: 48px;  height: 20px; text: "状态";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 186px; y: 232px; width: 54px;  height: 20px; text: "优先级"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 242px; y: 232px; width: 200px; height: 20px; text: "名称";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }

    // Task rows — 8 rows, each 22px tall (was 18px — too tight for 16px font)
    for idx in 4 : Rectangle {
        x: 24px; y: 254px + idx * 22px;
        width: 432px; height: 20px;

        Text { x: 0px;   width: 44px;  height: parent.height; text: root.task-tids[idx];   color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 46px;  width: 64px;  height: parent.height; text: root.task-types[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 112px; width: 48px;  height: parent.height; text: root.task-states[idx]; color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 162px; width: 54px;  height: parent.height; text: root.task-prios[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 218px; width: 200px; height: parent.height; text: root.task-names[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
    }

    // "省略 xx 个任务"
    Text {
        x: 24px; y: 342px; width: 408px; height: 20px;
        visible: root.task-hidden > 0;
        text: "还有 " + root.task-hidden + " 个任务";
        color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 400;
        vertical-alignment: center;
    }
}