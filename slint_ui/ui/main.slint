// Main entry point for the Slint UI example.
// Imports all page components and assembles the MainWindow.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Launcher } from "./launcher/launcher.slint";
import { DemoPage } from "./pages/demo-page.slint";
import { SchedMonPage } from "./pages/sched-mon-page.slint";
import { WifiScanPage, WifiNetwork } from "./pages/wifi-scan-page.slint";

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: #0b1115;
    default-font-size: 11px;

    property <int> current-app: -1;  // -1 = launcher, 6+ = app pages
    property <int> current-tab: 0;   // 0 = 内核, 1 = 外设
    property <float> tab-offset: 0.0;

    in property <[WifiNetwork]> networks;
    in-out property <bool> scanning: false;
    in-out property <int> result-count: 0;
    in-out property <string> status-text: "Preparing wireless scanner";
    callback scan-requested();

    // Kept for compatibility with the original example backend. The callback
    // disappears when the framebuffer backend is separated in a later change.
    callback reset-requested(bool);

    // Launcher
    if current-app == -1: Launcher {
        current-tab <=> root.current-tab;
        tab-offset <=> root.tab-offset;
        open-app(app-id) => { root.current-app = app-id; }
    }

    // App pages
    if current-app == 6: SchedMonPage { go-back => { root.current-app = -1; } }
    if current-app == 7: DemoPage { title: "CPU/Memory"; accent: #6fe0bd;  go-back => { root.current-app = -1; } }
    if current-app == 8: DemoPage { title: "文件 IO";    accent: #f0bd62;  go-back => { root.current-app = -1; } }
    if current-app == 9: DemoPage { title: "屏幕变色";  accent: #f08091;  go-back => { root.current-app = -1; } }
    if current-app == 10: DemoPage { title: "背光控制";  accent: #f0bd62;  go-back => { root.current-app = -1; } }
    if current-app == 11: DemoPage { title: "背景图";    accent: #cf8ff2;  go-back => { root.current-app = -1; } }
    // 外设 demo pages
    if current-app == 12: WifiScanPage {
        networks: root.networks;
        scanning <=> root.scanning;
        result-count <=> root.result-count;
        status-text <=> root.status-text;
        scan-requested => { root.scan-requested(); }
        go-back => { root.current-app = -1; }
    }
    if current-app == 13: DemoPage { title: "IMU Sensors"; accent: #f08091; go-back => { root.current-app = -1; } }
    if current-app == 14: DemoPage { title: "SD 卡";     accent: #f0bd62;  go-back => { root.current-app = -1; } }
    if current-app == 15: DemoPage { title: "HTTP GET";  accent: #5ca9ff;  go-back => { root.current-app = -1; } }
    if current-app == 16: DemoPage { title: "音频";      accent: #cf8ff2;  go-back => { root.current-app = -1; } }
}
