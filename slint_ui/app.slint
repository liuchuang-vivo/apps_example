// Blind-box touch demo for the 480x480 CO5300 AMOLED panel.
// Keep this compatible with SoftwareRenderer::render_by_line: no Path items.

component BlindBox inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> mark;
    in property <color> accent;
    in property <bool> opened: false;
    callback reveal();

    width: 136px;
    height: 104px;
    border-width: root.opened ? 2px : 1px;
    border-color: root.opened ? root.accent : #36464d;
    border-radius: 11px;
    background: root.opened ? #17252a : touch-area.pressed ? #21343b : #121b20;

    // A small accent strip makes each unopened box distinguishable while the
    // large question mark keeps the interaction obvious on a small panel.
    Rectangle {
        x: 10px;
        y: 10px;
        width: 5px;
        height: root.opened ? 80px : 20px;
        background: root.accent;
        border-radius: 2px;
    }

    Text {
        x: 24px;
        y: 8px;
        width: 100px;
        height: 34px;
        text: root.opened ? root.mark : "?";
        color: root.opened ? root.accent : #dbe7e7;
        font-size: root.opened ? 19px : 28px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 46px;
        width: 108px;
        height: 17px;
        text: root.opened ? root.title : "MYSTERY BOX";
        color: root.opened ? #f0f5f3 : #b9c7c8;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 18px;
        y: 68px;
        width: 112px;
        height: 18px;
        text: root.opened ? root.description : "TAP TO OPEN";
        color: root.opened ? #93a6a8 : #6c7e82;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch-area := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.reveal();
            }
        }
    }
}

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: #0b1115;
    default-font-size: 11px;

    property <int> opened-count: 0;
    property <string> last-reward: "Choose a box to begin";
    property <bool> box1-opened: false;
    property <bool> box2-opened: false;
    property <bool> box3-opened: false;
    property <bool> box4-opened: false;
    property <bool> box5-opened: false;
    property <bool> box6-opened: false;
    property <bool> box7-opened: false;
    property <bool> box8-opened: false;
    property <bool> box9-opened: false;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 76px;
        background: #111b20;

        Text {
            x: 22px;
            y: 10px;
            width: 250px;
            height: 25px;
            text: "LUCKY GRID";
            color: #edf4f1;
            font-size: 22px;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            x: 24px;
            y: 42px;
            width: 270px;
            height: 17px;
            text: "OPEN 9 BOXES / FIND 9 SURPRISES";
            color: #728489;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            x: 374px;
            y: 14px;
            width: 82px;
            height: 46px;
            background: #1d3037;
            border-radius: 8px;

            Text {
                x: 0px;
                y: 4px;
                width: parent.width;
                height: 15px;
                text: "OPENED";
                color: #7e999c;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 0px;
                y: 18px;
                width: parent.width;
                height: 23px;
                text: root.opened-count + "/9";
                color: #6fe0bd;
                font-size: 17px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 0;
        y: 75px;
        width: parent.width;
        height: 1px;
        background: #2a3a40;
    }

    BlindBox {
        x: 24px;
        y: 88px;
        title: "STAR CACHE";
        description: "A tiny constellation";
        mark: "STAR";
        accent: #f0bd62;
        opened: root.box1-opened;
        reveal => {
            if !root.box1-opened {
                root.box1-opened = true;
                root.opened-count += 1;
                root.last-reward = "STAR CACHE - a tiny constellation";
            }
        }
    }

    BlindBox {
        x: 172px;
        y: 88px;
        title: "PIXEL WIZARD";
        description: "CO5300 color spell";
        mark: "PIXEL";
        accent: #6fb6f2;
        opened: root.box2-opened;
        reveal => {
            if !root.box2-opened {
                root.box2-opened = true;
                root.opened-count += 1;
                root.last-reward = "PIXEL WIZARD - CO5300 color spell";
            }
        }
    }

    BlindBox {
        x: 320px;
        y: 88px;
        title: "COFFEE DROP";
        description: "Energy refill unlocked";
        mark: "COFFEE";
        accent: #da966c;
        opened: root.box3-opened;
        reveal => {
            if !root.box3-opened {
                root.box3-opened = true;
                root.opened-count += 1;
                root.last-reward = "COFFEE DROP - energy refill unlocked";
            }
        }
    }

    BlindBox {
        x: 24px;
        y: 198px;
        title: "BOLT PASS";
        description: "Fast lane for today";
        mark: "BOLT";
        accent: #e8df70;
        opened: root.box4-opened;
        reveal => {
            if !root.box4-opened {
                root.box4-opened = true;
                root.opened-count += 1;
                root.last-reward = "BOLT PASS - fast lane for today";
            }
        }
    }

    BlindBox {
        x: 172px;
        y: 198px;
        title: "LUCKY GEM";
        description: "Keep this one close";
        mark: "GEM";
        accent: #cf8ff2;
        opened: root.box5-opened;
        reveal => {
            if !root.box5-opened {
                root.box5-opened = true;
                root.opened-count += 1;
                root.last-reward = "LUCKY GEM - keep this one close";
            }
        }
    }

    BlindBox {
        x: 320px;
        y: 198px;
        title: "MOON MODE";
        description: "A calm night bonus";
        mark: "MOON";
        accent: #9ea8f4;
        opened: root.box6-opened;
        reveal => {
            if !root.box6-opened {
                root.box6-opened = true;
                root.opened-count += 1;
                root.last-reward = "MOON MODE - a calm night bonus";
            }
        }
    }

    BlindBox {
        x: 24px;
        y: 308px;
        title: "WAVE TOKEN";
        description: "Ride the blue wave";
        mark: "WAVE";
        accent: #64d1d8;
        opened: root.box7-opened;
        reveal => {
            if !root.box7-opened {
                root.box7-opened = true;
                root.opened-count += 1;
                root.last-reward = "WAVE TOKEN - ride the blue wave";
            }
        }
    }

    BlindBox {
        x: 172px;
        y: 308px;
        title: "HEART NOTE";
        description: "A warm little wish";
        mark: "HEART";
        accent: #f08091;
        opened: root.box8-opened;
        reveal => {
            if !root.box8-opened {
                root.box8-opened = true;
                root.opened-count += 1;
                root.last-reward = "HEART NOTE - a warm little wish";
            }
        }
    }

    BlindBox {
        x: 320px;
        y: 308px;
        title: "SECRET BONUS";
        description: "The final surprise";
        mark: "BONUS";
        accent: #71e0a9;
        opened: root.box9-opened;
        reveal => {
            if !root.box9-opened {
                root.box9-opened = true;
                root.opened-count += 1;
                root.last-reward = "SECRET BONUS - the final surprise";
            }
        }
    }

    Rectangle {
        x: 0;
        y: 424px;
        width: parent.width;
        height: 56px;
        background: #111b20;

        Rectangle {
            x: 24px;
            y: 13px;
            width: 5px;
            height: 30px;
            background: root.opened-count == 9 ? #6fe0bd : #f0bd62;
            border-radius: 2px;
        }

        Text {
            x: 40px;
            y: 8px;
            width: 320px;
            height: 18px;
            text: root.opened-count == 9 ? "ALL REVEALED - JACKPOT!" : root.last-reward;
            color: #edf4f1;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 40px;
            y: 28px;
            width: 320px;
            height: 15px;
            text: root.opened-count == 0 ? "Tap any box to reveal its reward" : "Tap unopened boxes to keep exploring";
            color: #778a8d;
            font-size: 8px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 394px;
            y: 12px;
            width: 62px;
            height: 32px;
            background: reset-area.pressed ? #31464d : #203239;
            border-radius: 7px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "RESET";
                color: #9db1b2;
                font-size: 8px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            reset-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.box1-opened = false;
                        root.box2-opened = false;
                        root.box3-opened = false;
                        root.box4-opened = false;
                        root.box5-opened = false;
                        root.box6-opened = false;
                        root.box7-opened = false;
                        root.box8-opened = false;
                        root.box9-opened = false;
                        root.opened-count = 0;
                        root.last-reward = "Choose a box to begin";
                    }
                }
            }
        }
    }
}
