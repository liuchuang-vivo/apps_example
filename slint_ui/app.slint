// This UI is rendered with SoftwareRenderer::render_by_line to minimize SRAM usage.
// Do not use Path items: Slint 1.17 does not support them in line-by-line mode.

component OrbitRing inherits Rectangle {
    in property <length> center-x: 148px;
    in property <length> center-y: 115px;
    in property <length> radius-x;
    in property <length> radius-y;
    in property <float> ring-opacity: 0.55;

    x: root.center-x - root.radius-x;
    y: root.center-y - root.radius-y;
    width: root.radius-x * 2;
    height: root.radius-y * 2;
    background: transparent;
    border-width: 1px;
    border-color: #304049;
    border-radius: root.radius-y;
    opacity: root.ring-opacity;
}

component OrbitPlanet inherits Rectangle {
    in property <float> phase;
    in property <length> center-x: 148px;
    in property <length> center-y: 115px;
    in property <length> radius-x;
    in property <length> radius-y;
    in property <length> diameter: 3px;
    in property <color> tint;
    in property <bool> ringed: false;
    property <float> orbit-x: root.phase < 0.125 ? 1 - root.phase * 2.344 : root.phase < 0.25 ? 0.707 - (root.phase - 0.125) * 5.656 : root.phase < 0.375 ? (root.phase - 0.25) * -5.656 : root.phase < 0.5 ? -0.707 - (root.phase - 0.375) * 2.344 : root.phase < 0.625 ? -1 + (root.phase - 0.5) * 2.344 : root.phase < 0.75 ? -0.707 + (root.phase - 0.625) * 5.656 : root.phase < 0.875 ? (root.phase - 0.75) * 5.656 : 0.707 + (root.phase - 0.875) * 2.344;
    property <float> orbit-y: root.phase < 0.125 ? root.phase * -5.656 : root.phase < 0.25 ? -0.707 - (root.phase - 0.125) * 2.344 : root.phase < 0.375 ? -1 + (root.phase - 0.25) * 2.344 : root.phase < 0.5 ? -0.707 + (root.phase - 0.375) * 5.656 : root.phase < 0.625 ? (root.phase - 0.5) * 5.656 : root.phase < 0.75 ? 0.707 + (root.phase - 0.625) * 2.344 : root.phase < 0.875 ? 1 - (root.phase - 0.75) * 2.344 : 0.707 - (root.phase - 0.875) * 5.656;

    x: root.center-x + root.radius-x * root.orbit-x - root.diameter / 2;
    y: root.center-y + root.radius-y * root.orbit-y - root.diameter / 2;
    width: root.diameter;
    height: root.diameter;
    background: root.tint;
    border-radius: root.diameter / 2;

    Rectangle {
        x: -2px;
        y: parent.height / 2;
        width: parent.width + 4px;
        height: 1px;
        background: #dcc88d;
        opacity: root.ringed ? 0.9 : 0;
    }
}

component PowerValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent;

    background: transparent;

    Rectangle {
        x: 0;
        y: 3px;
        width: 3px;
        height: parent.height - 6px;
        background: root.accent;
        border-radius: 1px;
    }

    Text {
        x: 10px;
        y: 0;
        width: parent.width - 10px;
        height: 12px;
        text: root.label;
        color: #737d86;
        font-size: 8px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        x: 10px;
        y: 11px;
        width: parent.width - 10px;
        height: 21px;
        text: root.value + root.unit;
        color: #f1f4f5;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MainWindow inherits Window {
    width: 320px;
    height: 480px;
    background: #0b0f12;
    default-font-size: 10px;

    in property <string> mcu-name: "ESP32C3";
    in property <string> board-name: "SENSOR NODE 01";
    in property <bool> system-ok: true;
    in property <string> temperature-value: "42.6";
    in property <float> temperature-level: 0.43;
    in property <string> cpu-value: "64%";
    in property <float> cpu-level: 0.64;
    in property <string> cpu-clock: "480 MHz";
    in property <string> ram-value: "48%";
    in property <float> ram-level: 0.48;
    in property <string> ram-detail: "245 / 512 KB";
    in property <string> flash-value: "71%";
    in property <float> flash-level: 0.71;
    in property <string> flash-detail: "1.42 / 2 MB";
    in property <string> voltage-value: "3.29";
    in property <string> current-value: "186";
    in property <string> uptime-value: "02:18:36";
    in property <string> firmware-version: "FW 1.4.2";
    in property <float> mercury-phase: 0;
    in property <float> venus-phase: 0.12;
    in property <float> earth-phase: 0.24;
    in property <float> mars-phase: 0.36;
    in property <float> jupiter-phase: 0.48;
    in property <float> saturn-phase: 0.60;
    in property <float> uranus-phase: 0.72;
    in property <float> neptune-phase: 0.84;
    in property <float> pluto-phase: 0.94;
    property <int> touch-click-count: 0;
    property <bool> config-visible: false;
    property <bool> config-touch-feedback: true;
    property <bool> config-animations: true;
    property <float> config-brightness: 80;
    callback touch-button-clicked();
    property <float> intro-progress: 0;
    property <float> pulse-level: 0.55;

    init => {
        intro-progress = 1;
        pulse-level = 1;
    }

    animate intro-progress {
        duration: 450ms;
        easing: ease-out;
    }

    animate pulse-level {
        duration: 900ms;
        easing: ease-in-out;
        iteration-count: -1;
        direction: alternate;
    }

    // Device header
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 52px;
        background: #11171b;

        Rectangle {
            x: 12px;
            y: 11px;
            width: 30px;
            height: 30px;
            background: #182127;
            border-width: 1px;
            border-color: #3a4850;
            border-radius: 5px;

            Rectangle {
                x: 7px;
                y: 7px;
                width: 16px;
                height: 16px;
                background: #0f1519;
                border-width: 1px;
                border-color: #43d6b0;
                border-radius: 2px;

                Rectangle {
                    x: 5px;
                    y: 5px;
                    width: 4px;
                    height: 4px;
                    background: #43d6b0;
                    border-radius: 2px;
                }
            }

            Rectangle { x: 4px; y: 2px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 13px; y: 2px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 22px; y: 2px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 4px; y: 24px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 13px; y: 24px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 22px; y: 24px; width: 3px; height: 4px; background: #65727a; }
            Rectangle { x: 2px; y: 4px; width: 4px; height: 3px; background: #65727a; }
            Rectangle { x: 2px; y: 13px; width: 4px; height: 3px; background: #65727a; }
            Rectangle { x: 2px; y: 22px; width: 4px; height: 3px; background: #65727a; }
            Rectangle { x: 24px; y: 4px; width: 4px; height: 3px; background: #65727a; }
            Rectangle { x: 24px; y: 13px; width: 4px; height: 3px; background: #65727a; }
            Rectangle { x: 24px; y: 22px; width: 4px; height: 3px; background: #65727a; }
        }

        Text {
            x: 51px;
            y: 9px;
            width: 190px;
            height: 19px;
            text: root.mcu-name;
            color: #f3f6f7;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 51px;
            y: 28px;
            width: 190px;
            height: 13px;
            text: root.board-name;
            color: #78838c;
            font-size: 8px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width - 66px;
            y: 16px;
            width: 54px;
            height: 21px;
            background: root.system-ok ? #173029 : #361d1d;
            border-width: 1px;
            border-color: root.system-ok ? #285c4e : #743636;
            border-radius: 5px;

            Rectangle {
                x: 8px;
                y: 7px;
                width: 7px;
                height: 7px;
                background: root.system-ok ? #43d6b0 : #ff6767;
                border-radius: 4px;
                opacity: root.system-ok ? root.pulse-level : 1;
            }

            Text {
                x: 19px;
                width: 31px;
                height: parent.height;
                text: root.system-ok ? "OK" : "FAULT";
                color: root.system-ok ? #9cebd5 : #ffaaaa;
                font-size: 8px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            x: 0;
            y: 51px;
            width: parent.width;
            height: 1px;
            background: #283036;
        }
    }

    // Primary MCU readings
    Rectangle {
        x: 12px;
        y: 67px - 4px * root.intro-progress;
        width: 140px;
        height: 78px;
        background: #151b1f;
        border-width: 1px;
        border-color: #293239;
        border-radius: 6px;
        opacity: root.intro-progress;

        Text {
            x: 10px;
            y: 8px;
            width: 120px;
            height: 12px;
            text: "CORE TEMP";
            color: #8b959d;
            font-size: 8px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: 10px;
            y: 25px;
            width: 88px;
            height: 28px;
            text: root.temperature-value;
            color: #f5b75c;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 105px;
            y: 26px;
            width: 25px;
            height: 18px;
            text: "C";
            color: #c6cdd1;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            x: 10px;
            y: 62px;
            width: 120px;
            height: 5px;
            background: #2b2d2b;
            border-radius: 2px;

            Rectangle {
                width: parent.width * root.temperature-level;
                height: parent.height;
                background: #f5b75c;
                border-radius: 2px;
                opacity: 0.82 + 0.18 * root.pulse-level;
            }
        }
    }

    Rectangle {
        x: 168px;
        y: 67px - 4px * root.intro-progress;
        width: 140px;
        height: 78px;
        background: #151b1f;
        border-width: 1px;
        border-color: #293239;
        border-radius: 6px;
        opacity: root.intro-progress;

        Text {
            x: 10px;
            y: 8px;
            width: 120px;
            height: 12px;
            text: "CPU LOAD";
            color: #8b959d;
            font-size: 8px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: 10px;
            y: 23px;
            width: 120px;
            height: 29px;
            text: root.cpu-value;
            color: #43d6b0;
            font-size: 25px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 10px;
            y: 55px;
            width: 120px;
            height: 1px;
            background: #30383d;
        }

        Text {
            x: 10px;
            y: 59px;
            width: 120px;
            height: 12px;
            text: root.cpu-clock;
            color: #9aa4aa;
            font-size: 8px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Nine-planet orbit simulation
    Text {
        x: 12px;
        y: 144px;
        width: 180px;
        height: 12px;
        text: "NINE PLANET ORBITS";
        color: #6f7a82;
        font-size: 8px;
        font-weight: 700;
        vertical-alignment: center;
        opacity: root.intro-progress;
    }

    Text {
        x: 200px;
        y: 144px;
        width: 108px;
        height: 12px;
        text: "SIM ACTIVE";
        color: #8f99a0;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        opacity: root.intro-progress;
    }

    Rectangle {
        x: 12px;
        y: 158px;
        width: 296px;
        height: 253px;
        background: #0d1317;
        border-width: 1px;
        border-color: #293239;
        border-radius: 5px;
        clip: true;
        opacity: root.intro-progress;

        Text {
            x: 9px;
            y: 4px;
            width: 278px;
            height: 9px;
            text: "ME  VE  EA  MA  JU  SA  UR  NE  PL";
            color: #56636b;
            font-size: 7px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle { x: 28px; y: 31px; width: 2px; height: 2px; background: #71808a; opacity: root.pulse-level; }
        Rectangle { x: 250px; y: 48px; width: 2px; height: 2px; background: #8b969d; opacity: 1.2 - root.pulse-level; }
        Rectangle { x: 54px; y: 205px; width: 1px; height: 1px; background: #9aa5ab; }
        Rectangle { x: 232px; y: 179px; width: 2px; height: 2px; background: #65747d; opacity: root.pulse-level; }
        Rectangle { x: 270px; y: 117px; width: 1px; height: 1px; background: #8d999f; }

        OrbitRing { radius-x: 13px; radius-y: 8px; ring-opacity: 0.34; }
        OrbitRing { radius-x: 23px; radius-y: 15px; ring-opacity: 0.36; }
        OrbitRing { radius-x: 35px; radius-y: 23px; ring-opacity: 0.38; }
        OrbitRing { radius-x: 47px; radius-y: 32px; ring-opacity: 0.40; }
        OrbitRing { radius-x: 61px; radius-y: 42px; ring-opacity: 0.44; }
        OrbitRing { radius-x: 76px; radius-y: 52px; ring-opacity: 0.46; }
        OrbitRing { radius-x: 92px; radius-y: 64px; ring-opacity: 0.48; }
        OrbitRing { radius-x: 110px; radius-y: 77px; ring-opacity: 0.50; }
        OrbitRing { radius-x: 130px; radius-y: 90px; ring-opacity: 0.52; }

        Rectangle {
            x: 141px;
            y: 108px;
            width: 14px;
            height: 14px;
            background: #f5b75c;
            border-radius: 7px;
            opacity: 0.18 + 0.10 * root.pulse-level;
        }
        Rectangle {
            x: 144px;
            y: 111px;
            width: 8px;
            height: 8px;
            background: #ffd46b;
            border-radius: 4px;
        }

        OrbitPlanet { phase: root.mercury-phase; radius-x: 13px; radius-y: 8px; diameter: 2px; tint: #aeb5b8; }
        OrbitPlanet { phase: root.venus-phase; radius-x: 23px; radius-y: 15px; diameter: 3px; tint: #d8a968; }
        OrbitPlanet { phase: root.earth-phase; radius-x: 35px; radius-y: 23px; diameter: 3px; tint: #5ca9ff; }
        OrbitPlanet { phase: root.mars-phase; radius-x: 47px; radius-y: 32px; diameter: 2px; tint: #d86f50; }
        OrbitPlanet { phase: root.jupiter-phase; radius-x: 61px; radius-y: 42px; diameter: 6px; tint: #d8b088; }
        OrbitPlanet { phase: root.saturn-phase; radius-x: 76px; radius-y: 52px; diameter: 5px; tint: #d7c17e; ringed: true; }
        OrbitPlanet { phase: root.uranus-phase; radius-x: 92px; radius-y: 64px; diameter: 4px; tint: #82d4d7; }
        OrbitPlanet { phase: root.neptune-phase; radius-x: 110px; radius-y: 77px; diameter: 4px; tint: #537fd1; }
        OrbitPlanet { phase: root.pluto-phase; radius-x: 130px; radius-y: 90px; diameter: 2px; tint: #b6a89a; }

        Text {
            x: 9px;
            y: 235px;
            width: 278px;
            height: 8px;
            text: "ORBIT SCALE: VISUALIZED";
            color: #48555d;
            font-size: 6px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // Power rail summary
    Rectangle {
        x: 0;
        y: 421px;
        width: parent.width;
        height: 59px;
        background: #11171b;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: #283036;
        }

        PowerValue {
            x: 12px;
            y: 12px;
            width: 80px;
            height: 38px;
            label: "VCORE";
            value: root.voltage-value;
            unit: "V";
            accent: #43d6b0;
        }

        PowerValue {
            x: 104px;
            y: 12px;
            width: 90px;
            height: 38px;
            label: "CURRENT";
            value: root.current-value;
            unit: "mA";
            accent: #5ca9ff;
        }

        Rectangle {
            x: 204px;
            y: 10px;
            width: 1px;
            height: 40px;
            background: #30383d;
        }

        touch-test-button := Rectangle {
            x: 216px;
            y: 8px;
            width: 92px;
            height: 43px;
            background: touch-area.pressed ? #236b5a : root.touch-click-count > 0 ? #17483e : #173029;
            border-width: 1px;
            border-color: touch-area.pressed ? #7ff0cf : #43d6b0;
            border-radius: 6px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "OPEN CONFIG";
                color: #d8fff3;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch-area := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.touch-click-count += 1;
                        root.config-visible = true;
                        root.touch-button-clicked();
                    }
                }
            }
        }
    }

    if root.config-visible: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #05080bcc;

        Rectangle {
            x: 22px;
            y: 72px;
            width: 276px;
            height: 336px;
            background: #121a1f;
            border-width: 1px;
            border-color: #43d6b0;
            border-radius: 9px;

            Text {
                x: 16px;
                y: 14px;
                width: 190px;
                height: 22px;
                text: "CONFIGURATION";
                color: #effffb;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 16px;
                y: 38px;
                width: 210px;
                height: 14px;
                text: "FT6336U TOUCH PANEL";
                color: #718089;
                font-size: 8px;
                font-weight: 600;
                vertical-alignment: center;
            }

            close-button := Rectangle {
                x: 230px;
                y: 12px;
                width: 30px;
                height: 30px;
                background: close-touch.pressed ? #6b3030 : #321d1d;
                border-width: 1px;
                border-color: #7d3f3f;
                border-radius: 5px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "X";
                    color: #ffb0b0;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

            }

            close-touch := TouchArea {
                x: 220px;
                y: 4px;
                width: 48px;
                height: 48px;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.config-visible = false;
                    }
                }
            }

            Rectangle {
                x: 16px;
                y: 64px;
                width: 244px;
                height: 1px;
                background: #2a353b;
            }

            Text {
                x: 16px;
                y: 78px;
                width: 150px;
                height: 17px;
                text: "TOUCH FEEDBACK";
                color: #cbd3d7;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }

            touch-feedback-switch := Rectangle {
                x: 200px;
                y: 74px;
                width: 60px;
                height: 26px;
                background: root.config-touch-feedback ? #17483e : #252d31;
                border-width: 1px;
                border-color: root.config-touch-feedback ? #43d6b0 : #4b555a;
                border-radius: 13px;

                Rectangle {
                    x: root.config-touch-feedback ? 36px : 4px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    background: root.config-touch-feedback ? #8aefd3 : #778188;
                    border-radius: 9px;
                    animate x { duration: 120ms; }
                }

            }


            touch-feedback-area := TouchArea {
                x: 12px;
                y: 68px;
                width: 252px;
                height: 38px;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.config-touch-feedback = !root.config-touch-feedback;
                    }
                }
            }

            Text {
                x: 16px;
                y: 122px;
                width: 150px;
                height: 17px;
                text: "UI ANIMATIONS";
                color: #cbd3d7;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }

            animations-switch := Rectangle {
                x: 200px;
                y: 118px;
                width: 60px;
                height: 26px;
                background: root.config-animations ? #17483e : #252d31;
                border-width: 1px;
                border-color: root.config-animations ? #43d6b0 : #4b555a;
                border-radius: 13px;

                Rectangle {
                    x: root.config-animations ? 36px : 4px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    background: root.config-animations ? #8aefd3 : #778188;
                    border-radius: 9px;
                    animate x { duration: 120ms; }
                }

            }


            animations-area := TouchArea {
                x: 12px;
                y: 112px;
                width: 252px;
                height: 38px;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.config-animations = !root.config-animations;
                    }
                }
            }

            Text {
                x: 16px;
                y: 168px;
                width: 150px;
                height: 17px;
                text: "BRIGHTNESS  " + round(root.config-brightness) + "%";
                color: #cbd3d7;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }

            brightness-slider := Rectangle {
                x: 16px;
                y: 194px;
                width: 244px;
                height: 38px;
                background: #0e1519;
                border-width: 1px;
                border-color: slider-area.pressed ? #43d6b0 : #2d3b42;
                border-radius: 5px;

                Rectangle {
                    x: 10px;
                    y: 16px;
                    width: 224px;
                    height: 6px;
                    background: #263238;
                    border-radius: 3px;

                    Rectangle {
                        width: parent.width * root.config-brightness / 100;
                        height: parent.height;
                        background: #43d6b0;
                        border-radius: 3px;
                    }
                }

                Rectangle {
                    x: 4px + 222px * root.config-brightness / 100;
                    y: 8px;
                    width: 18px;
                    height: 22px;
                    background: slider-area.pressed ? #b4ffe9 : #8aefd3;
                    border-width: 1px;
                    border-color: #d4fff3;
                    border-radius: 9px;
                    animate x { duration: 60ms; }
                }

                slider-area := TouchArea {
                    function update-brightness() {
                        root.config-brightness = round(max(0, min(100, self.mouse-x * 100 / self.width)));
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            self.update-brightness();
                        }
                    }

                    moved => {
                        if self.pressed {
                            self.update-brightness();
                        }
                    }
                }
            }

            Text {
                x: 16px;
                y: 246px;
                width: 244px;
                height: 16px;
                text: "Touch the controls to verify input routing";
                color: #66747c;
                font-size: 8px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            save-button := Rectangle {
                x: 16px;
                y: 278px;
                width: 244px;
                height: 42px;
                background: save-area.pressed ? #236b5a : #17483e;
                border-width: 1px;
                border-color: #43d6b0;
                border-radius: 6px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "SAVE & CLOSE";
                    color: #d8fff3;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                save-area := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.config-visible = false;
                        }
                    }
                }
            }
        }
    }
}
